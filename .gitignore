# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencias
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing y cobertura
/coverage
test-results/
playwright-report/
blob-report/

# Next.js y empaquetado de producción
/.next/
/out/
/build
.turbo/
*.tsbuildinfo
next-env.d.ts

# Variables de entorno y secretos (nunca commitear credenciales)
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Vercel
.vercel

# Firebase y emuladores locales
.firebase/
dataconnect/.dataconnect/
*-debug.log
firebase-debug.log*
dataconnect-debug.log*
ui-debug.log*

# IDEs y editores
.idea/
.vscode/
*.swp
*.swo
*~
*.iml
*.ipr
*.iws

# Sistema operativo
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Logs y volcados
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*.hprof
hs_err_pid*

# Descargas locales y exportaciones temporales
/*.pdf
/*.xlsx
/*.csv

# Scratch scripts y pruebas diagnósticas locales
/scratch/
scripts/scratch-*
scripts/test-*-app.mjs

# AI / agent tooling (no versionar configuración de asistentes de IA)
CLAUDE.md
.claude/
.agents/
.cursor/
.github/copilot-instructions.md
GEMINI.md
AGENTS.md
skills-lock.json
.aider*
.artifacts/
