# Completar con la configuración SDK web del proyecto Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Obligatorio para emitir QR. Usar el dominio estable, nunca el de una preview.
NEXT_PUBLIC_SEGUIMIENTO_BASE_URL=https://lavanderia-elcobre.vercel.app

# Solo servidor: cuenta de servicio con acceso a Auth, Data Connect y al bucket.
# Preferir identidad administrada/ADC cuando el hosting lo permita.
# Nunca usar prefijo NEXT_PUBLIC para esta variable.
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=
# Secreto aleatorio para seudonimizar el origen del límite de contactos (mínimo 32 caracteres).
CONTACT_RATE_LIMIT_SALT=

# Identidad y condiciones confirmadas por el responsable. Solo servidor.
# No se habilitan nuevas autorizaciones públicas hasta completar y aprobar el aviso.
LEGAL_RAZON_SOCIAL=
LEGAL_RUT=
LEGAL_DOMICILIO=
LEGAL_REPRESENTANTE=
# Opcional: el canal de derechos es el formulario público. No usar ventas sin autorización.
LEGAL_EMAIL_DERECHOS=
LEGAL_CONSERVACION=
LEGAL_PROVEEDORES_TRANSFERENCIAS=
# Debe coincidir con VERSION_PRIVACIDAD tras revisar el texto y la configuración.
LEGAL_AVISO_APROBADO_VERSION=
